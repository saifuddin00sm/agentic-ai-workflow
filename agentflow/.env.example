# LLM Provider
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: Tavily web search (auto-disabled if missing)
TAVILY_API_KEY=tvly-...

# Pipeline settings
PIPELINE_STAGE_TIMEOUT_S=60
PIPELINE_MAX_RESEARCH_TASKS=8
PIPELINE_RESEARCH_CONCURRENCY=4
PIPELINE_MAX_AGENT_ITERATIONS=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
